{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laverock",
  "version": "0.1.0-alpha",
  "identifier": "sh.laverock.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/laverock"],
    "resources": {
      "../../scripts/download-model.sh": "scripts/download-model.sh",
      "../../scripts/download-voxcpm2.sh": "scripts/download-voxcpm2.sh",
      "../../scripts/download-qwen3tts.sh": "scripts/download-qwen3tts.sh",
      "../../scripts/qwen3tts_runner.py": "scripts/qwen3tts_runner.py"
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
