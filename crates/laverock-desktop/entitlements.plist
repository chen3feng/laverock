<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri signs with the Hardened Runtime, which gates microphone
       access behind this entitlement; without it getUserMedia fails
       immediately with NotAllowedError and no TCC prompt. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
