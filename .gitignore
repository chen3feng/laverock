/target
**/target/

# Downloaded engine models (each model dir carries an engine.json manifest)
/models/*
!/models/.gitkeep

# Local data
/data
/.env
*.tar.bz2

# Build tooling (llama.cpp-omni checkout used by download-voxcpm2.sh)
/.tools

# Sidecar binaries staged for bundling
**/binaries/

# Portable MinGit fetched for the Windows installer (scripts/fetch-mingit.sh).
# Keep only README.txt tracked so the tauri-build resources glob matches on a
# clean checkout; the real tree is downloaded/extracted at release time.
/crates/laverock-desktop/mingit/*
!/crates/laverock-desktop/mingit/README.txt

# Tauri generated ACL schemas
**/gen/schemas/

# OS/editor
.DS_Store
.idea/
.vscode/

# Python bytecode
__pycache__/
*.pyc
